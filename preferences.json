[
  {
    "type": "text",
    "label": "**Tuck away**",
    "size": "15px",
    "margin": "0 0 8px 0"
  },
  {
    "type": "text",
    "label": "The player slides into the nearest screen edge and leaves a small strip.",
    "margin": "0 0 12px 0"
  },
  {
    "property": "pip-tuck-away.right-click",
    "label": "Tuck away on right click",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.frosted",
    "label": "Tucked PiP Frosted Glass *The strip a tucked player leaves is frosted, so it reads as a handle rather than a chopped-up sliver. Off, the strip is plain video.*",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.overlay",
    "label": "Tuck Control Overlay",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.direction",
    "label": "Tuck Direction",
    "type": "dropdown",
    "defaultValue": "smart",
    "options": [
      {
        "label": "Smart",
        "value": "smart"
      },
      {
        "label": "Right",
        "value": "right"
      },
      {
        "label": "Top",
        "value": "top"
      },
      {
        "label": "Left",
        "value": "left"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ]
  },
  {
    "property": "pip-tuck-away.drag-tuck",
    "label": "Tuck when dragged past the edge",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.width",
    "label": "Tuck width",
    "type": "dropdown",
    "defaultValue": "normal",
    "options": [
      {
        "label": "Normal",
        "value": "normal"
      },
      {
        "label": "Wide",
        "value": "wide"
      },
      {
        "label": "Very wide",
        "value": "very-wide"
      }
    ]
  },
  {
    "property": "pip-tuck-away.shortcut",
    "label": "Toggle with **Ctrl+Alt+T**",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.hover-peek",
    "label": "Peek while hovering the tucked strip",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "pip-tuck-away.inline-in-zen",
    "label": "Pop the player out when leaving Zen",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "pip-tuck-away.in-widget",
    "label": "PiP uses the widget (low framerate) *While the browser is in front, the video plays in the media widget and no player window is opened, so picture-in-picture stays yours. In the background the standard picture-in-picture is used, with its own size, place and tucked edge. Firefox can only hand the widget a picture by reading every frame back on the CPU, so the video in the widget plays at a lower frame rate than the video itself.*",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "pip-tuck-away.auto-tuck",
    "label": "Auto tuck on PiP switch",
    "type": "checkbox",
    "defaultValue": false
  }
]
